# ── Database ───────────────────────────────────────────────────────────────────
# Get this from your Neon project dashboard → Connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Clerk ─────────────────────────────────────────────────────────────────────
# From Clerk dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ── Hocuspocus WebSocket server ───────────────────────────────────────────────
# URL the browser uses to connect (use wss:// in production)
NEXT_PUBLIC_HOCUSPOCUS_URL=ws://localhost:1234
# Port the Hocuspocus process listens on (default: 1234)
HOCUSPOCUS_PORT=1234
# Internal URL + secret for the snapshot-restore API to call Hocuspocus
# (Next.js API → Hocuspocus, server-to-server only)
HOCUSPOCUS_INTERNAL_URL=http://localhost:1234
HOCUSPOCUS_INTERNAL_SECRET=change-me-in-production
